# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Canonical deployed origin — drives metadataBase, canonical tags, OG/Twitter
# images, JSON-LD, robots.txt and sitemap.xml. Falls back to the Vercel URL
# if unset. Update this (only this) when the custom domain goes live.
NEXT_PUBLIC_SITE_URL=https://e-commerce-website-web.vercel.app

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# REQUIRED in production — checkout/reviews/newsletter/etc. rate limiting
# fails closed (503) without these. In development, missing Redis just logs
# a warning and allows requests through.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Safaricom Daraja (M-Pesa) ────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa
# High-entropy random secret appended to the callback URL as ?secret=...
# Safaricom does not support custom request headers, so this query-string secret
# is the verification method. Generate with: openssl rand -hex 32
# Rotate by updating this value + redeploying. Scrub old value from logs after rotation.
MPESA_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
MPESA_ENVIRONMENT=sandbox
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
# B2C (refunds/payouts) — optional, only needed if the app initiates B2C transfers
MPESA_B2C_SHORTCODE=your-b2c-shortcode
MPESA_INITIATOR_NAME=your-initiator-name
MPESA_SECURITY_CREDENTIAL=your-encrypted-security-credential
MPESA_B2C_RESULT_URL=https://your-domain.com/api/webhooks/mpesa

# ─── Flutterwave (card / mobile money / bank transfer / USSD) ────────────────
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-secret-key
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-verif-hash

# ─── Buy Now Pay Later (generic hosted-checkout-link provider, e.g. Lipa Later)
# Unset = BNPL option hidden from checkout. {amount}/{ref}/{phone} are
# substituted into the URL template at checkout time.
BNPL_PAYMENT_URL_TEMPLATE=https://provider.example/pay?amount={amount}&ref={ref}&phone={phone}
NEXT_PUBLIC_BNPL_NAME=Lipa Later

# ─── Paybill (manual M-Pesa, matched via the C2B webhook) ────────────────────
NEXT_PUBLIC_MPESA_PAYBILL=your-paybill-number
NEXT_PUBLIC_MPESA_PAYBILL_NAME=Elite Style Co.

# ─── Delivery ─────────────────────────────────────────────────────────────────
DELIVERY_FEE_OUTSIDE_CBD=300
NEXT_PUBLIC_DELIVERY_FEE_OUTSIDE_CBD=300

# ─── Africa's Talking (SMS + WhatsApp-via-AT) ────────────────────────────────
AFRICASTALKING_API_KEY=your-at-api-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=NairobiFash

# ─── WhatsApp Business Cloud API (order-status messages) ────────────────────
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Used for the newsletter welcome-discount email, Equinox notifications, and
# contact-form forwarding. Optional — submissions are still stored in
# Supabase regardless; the app just skips the email step when unset.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@your-domain.com

# ─── Jina AI (CLIP embeddings for photo/visual search) ───────────────────────
JINA_API_KEY=your-jina-api-key

# ─── Analytics & marketing pixels ─────────────────────────────────────────────
# Every one of these is optional and independently no-ops when unset — the
# site never errors because marketing isn't configured. All are gated behind
# visitor cookie consent (see CookieConsent.tsx) regardless of being set.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your-tiktok-pixel-id

# ─── Sentry ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=nairobi-fashion-web

# ─── Security ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your-32-char-random-secret-here

# Staff admin login password — checked at /admin/login.
# Required: admin area is locked (fail-closed) if this is unset.
# Generate with: openssl rand -hex 32
ADMIN_PASSWORD=generate-with-openssl-rand-hex-32

# Long random string stored in the admin_session HttpOnly cookie after login.
# Must not be the same as ADMIN_PASSWORD — the password is never put in a cookie.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_TOKEN=generate-with-openssl-rand-hex-32

ADMIN_JWT_SECRET=your-admin-jwt-secret-here
CRON_SECRET=your-cron-secret-for-vercel-crons

# Owner-only finance module password — checked at /admin/finance/login.
# Keep completely separate from ADMIN_PASSWORD.
# Generate with: openssl rand -hex 32
OWNER_PASSWORD=generate-with-openssl-rand-hex-32

# Token stored in the owner_session HttpOnly cookie after owner login.
# Must not be the same as OWNER_PASSWORD.
# Generate with: openssl rand -hex 32
OWNER_SESSION_TOKEN=generate-with-openssl-rand-hex-32

# ─── Support / Contact (public — shown to customers) ─────────────────────────
# Override these to display your real support contact details.
# Defaults fall back to demo placeholders — replace before going live.
NEXT_PUBLIC_SUPPORT_PHONE=+254 700 000 000
NEXT_PUBLIC_SUPPORT_WHATSAPP=https://wa.me/254700000000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@elitestyle.co.ke

# ─── Worker (notifications service) ──────────────────────────────────────────
# Used in SMS/WhatsApp templates — server-side only (no NEXT_PUBLIC_ prefix).
SUPPORT_PHONE=+254 700 000 000

# ─── Rate Limiting Notes ──────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are REQUIRED in production.
# Without them, the checkout endpoint returns 503 in production (fail-closed).
# In development, missing Redis logs a warning and allows requests through.

# ─── Vercel (set in dashboard, listed here for reference) ─────────────────────
# VERCEL_URL — auto-injected by Vercel
# VERCEL_ENV — auto-injected by Vercel
