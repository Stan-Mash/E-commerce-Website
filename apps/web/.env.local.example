# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # Server-only, never expose to client

# ─── M-Pesa (Daraja API) ────────────────────────────────────────────────────
# Get these from: https://developer.safaricom.co.ke → My Apps
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379                                 # Use Safaricom sandbox shortcode for testing
MPESA_PASSKEY=your-lipa-na-mpesa-passkey
MPESA_CALLBACK_URL=https://elitestyle.co.ke/api/mpesa/callback
# Set to "sandbox" for development, "production" for live
MPESA_ENVIRONMENT=sandbox

# ─── Admin ──────────────────────────────────────────────────────────────────
# REQUIRED. No fallback — if unset, the admin area is locked (fail closed).
ADMIN_PASSWORD=change-me-before-going-live
# REQUIRED. Secret value stored in the admin session cookie. Generate with:
#   openssl rand -hex 32
# If unset, ALL admin auth fails. Rotating this value logs everyone out.
ADMIN_SESSION_TOKEN=generate-a-long-random-string
# Owner-only finance module session token (separate from staff admin)
OWNER_SESSION_TOKEN=generate-another-long-random-string

# ─── Payments: Flutterwave (cards, Airtel Money, bank, M-Pesa) ───────────────
# Get these from: https://app.flutterwave.com → Settings → API Keys
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your-webhook-secret-hash
# Leave blank/test keys to keep card payments in test mode.

# ─── Payments: M-Pesa Paybill (manual / display) ─────────────────────────────
# Shown to customers who choose "Pay by Paybill". Your Safaricom Paybill number.
NEXT_PUBLIC_MPESA_PAYBILL=000000
NEXT_PUBLIC_MPESA_PAYBILL_NAME=Elite Style Co.

# ─── Delivery ────────────────────────────────────────────────────────────────
# Flat fee (KES) for deliveries OUTSIDE Nairobi CBD. Inside CBD is free.
DELIVERY_FEE_OUTSIDE_CBD=300
# Same value, exposed to the browser so checkout can show the fee before submit.
NEXT_PUBLIC_DELIVERY_FEE_OUTSIDE_CBD=300

# ─── Cloudinary (product images / videos) ───────────────────────────────────
# Get these from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ─── App URL ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
